{
  "_comment": "KCPVPN 配置文件示例。複製為 config.json 並編輯。字段含義見 README；未填寫的字段將使用默認值。",
  "mode": "server",
  "addr": "127.0.0.1:4000",
  "tap": "tap0",
  "v4net": "10.0.0.0/24",
  "v6net": "fd00::/64",
  "fec-d": 5,
  "fec-p": 2,
  "crypt": "aes-gcm",
  "psk": "CHANGE_ME_STRONG_SECRET",
  "obfs": "none",
  "pad-max": 0,
  "mtu": 1500,
  "sndwnd": 4096,
  "rcvwnd": 4096,
  "dscp": 0,
  "log-level": "warn",
  "max-clients": 256,
  "max-rate": 0,
  "fwmark": 0,
  "web-enabled": false,
  "web-bind": "local",
  "web-addr": ":8080",
  "web-token": "",
  "ip4": "",
  "ip6": "",
  "mac": ""
}
